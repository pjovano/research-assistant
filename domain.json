{
  "name": "research-assistant",
  "summary": "The research library's librarian and the user's research assistant: files and extracts PDFs, answers research questions from them, and keeps the user's research writing.",
  "folders": [
    {
      "name": "library",
      "access": "write"
    },
    {
      "name": "research vault",
      "access": "write",
      "write_within": [
        "corpus",
        "bibliographies",
        "writing"
      ]
    }
  ],
  "policy": {
    "allow": [
      "Bash(~/.research-vault/venv/bin/python -m unittest discover -s tests:*)",
      "Bash(~/.research-vault/venv/bin/ruff check:*)",
      "Bash(~/.research-vault/venv/bin/python tests/capture_goldens.py:*)",
      "Bash(~/.research-vault/venv/bin/python lib/vault.py:*)",
      "Bash(~/.research-vault/venv/bin/python lib/zotero.py:*)",
      "Bash(~/.research-vault/venv/bin/python lib/annotate.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/clean-pdfs/scripts/clean.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/file-pdfs/scripts/file.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/extract-corpus/scripts/extract.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/classify-and-place/scripts/bibliographies.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/discover/scripts/discover.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/extract-chapters/scripts/volumes.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/search/scripts/search.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/cite-links/scripts/cite.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/cite-links/scripts/graph.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/answer-questions/scripts/verify.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/vault-audit/scripts/audit.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/transcribe-talks/scripts/transcribe.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/ingest/scripts/ingest.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/manage-projects/scripts/projects.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/take-notes/scripts/notes.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/edit-drafts/scripts/drafts.py:*)",
      "Bash(~/.research-vault/venv/bin/python .claude/skills/remember/scripts/check_user_file.py:*)",
      "Bash(~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/clean-pdfs/scripts/clean.py:*)",
      "Bash(~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/file-pdfs/scripts/file.py:*)",
      "Bash(~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/extract-corpus/scripts/extract.py:*)",
      "Bash(~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/classify-and-place/scripts/bibliographies.py:*)",
      "Bash(~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/search/scripts/search.py:*)",
      "Bash(~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/ingest/scripts/ingest.py:*)",
      "Bash(git status --porcelain)",
      "Bash(git branch --show-current)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push -u origin extract-fixes/:*)",
      "Bash(git show:*)",
      "Bash(git pull:*)",
      "Bash(git branch -d extract-fixes/:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge:*)",
      "Edit(~/Documents/research vault/corpus/**)",
      "Edit(~/Documents/research vault/bibliographies/**)",
      "Edit(~/Documents/research vault/writing/**)",
      "mcp__vault-rag__search_hybrid",
      "mcp__vault-rag__index_status",
      "mcp__vault-rag__get_frontmatter",
      "mcp__vault-rag__list_works",
      "mcp__vault-rag__cites",
      "mcp__vault-rag__cited_by",
      "mcp__vault-rag__neighbours",
      "mcp__vault-rag__contexts",
      "mcp__vault-rag__outline"
    ],
    "prompt_on": {
      "--replace": "rewrites a corpus file's body; contract §4 allows it only on the user's instruction",
      "sync --rebuild": "empties the search stores before syncing every corpus file",
      "drop-page": "deletes a page from the only copy of the PDF when run with --apply",
      "toc clear": "destroys the whole outline",
      "revise": "changes or deletes the user's own annotations when run with --apply",
      "capture_goldens.py --apply": "overwrites the goldens, the only record of prior behaviour",
      "sweep --apply": "deletes scratch entries",
      "labels --apply": "rewrites a library PDF with the corpus file's folios as its page labels; contract §5 names it an authorized overwrite of a filed PDF"
    },
    "network_hosts": [
      "127.0.0.1",
      "localhost",
      "api.crossref.org",
      "openlibrary.org",
      "covers.openlibrary.org",
      "www.googleapis.com",
      "books.google.com",
      "arxiv.org",
      "export.arxiv.org",
      "openaipublic.blob.core.windows.net"
    ],
    "allow_local_binding": true,
    "write_paths": [
      "~/Desktop/inbox",
      "~/.research-vault/rag",
      "~/.research-vault/cache",
      "~/.research-vault/tiktoken",
      "~/.cache/datalab",
      "~/.cache/huggingface",
      "~/.cache/torch"
    ],
    "excluded_commands": [
      "gh *",
      "git push *",
      "git pull *",
      "git fetch *",
      "git checkout *",
      "git switch *",
      "git merge *",
      "git rebase *",
      "git reset *",
      "git restore *",
      "git stash *",
      "git rm *",
      "git mv *",
      "git cherry-pick *",
      "git revert *",
      "git worktree *",
      "uv pip *",
      "~/.research-vault/venv/bin/python .claude/skills/vault-audit/scripts/audit.py accept*",
      "~/.research-vault/venv/bin/python .claude/skills/clean-pdfs/scripts/clean.py *",
      "~/.research-vault/venv/bin/python .claude/skills/extract-corpus/scripts/extract.py *",
      "~/.research-vault/venv/bin/python .claude/skills/search/scripts/search.py *",
      "~/.research-vault/venv/bin/python .claude/skills/ingest/scripts/ingest.py *",
      "~/.research-vault/venv/bin/python .claude/skills/transcribe-talks/scripts/transcribe.py *",
      "~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/clean-pdfs/scripts/clean.py *",
      "~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/extract-corpus/scripts/extract.py *",
      "~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/search/scripts/search.py *",
      "~/.research-vault/venv/bin/python ~/Developer/research-assistant/.claude/skills/ingest/scripts/ingest.py *"
    ]
  }
}
