#!/usr/bin/env bash
set -uo pipefail

readonly INTERPRETER="$HOME/.research-vault/venv/bin/python"
readonly LINTER="$HOME/.research-vault/venv/bin/ruff"
readonly AUDIT_SCRIPT=".claude/skills/vault-audit/scripts/audit.py"
readonly NAMED_WORKS_FAIL='import json, sys
works = json.load(sys.stdin)["works"]
for work in works:
    print(work["file"], work["line"], " " + work["detail"], sep=":")
sys.exit(1 if works else 0)'

FAILED_CHECKS=""

run_check() {
  local label="$1"
  shift
  "$@" || record_failure "$label"
}

record_failure() {
  echo "pre-push: $1 failed" >&2
  FAILED_CHECKS="$FAILED_CHECKS; $1"
}

run_suite() {
  "$INTERPRETER" -m unittest discover -s tests
}

run_linter() {
  "$LINTER" check .
}

run_audit_linter() {
  "$INTERPRETER" "$AUDIT_SCRIPT" lint | "$INTERPRETER" -c "$NAMED_WORKS_FAIL"
}

enter_the_pushing_tree() {
  cd "$(git rev-parse --show-toplevel)" || exit 1
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE
}

refuse_unless_every_check_passed() {
  if [ -n "$FAILED_CHECKS" ]; then
    echo "pre-push: the push is refused; failed: ${FAILED_CHECKS#; }" >&2
    exit 1
  fi
}

main() {
  enter_the_pushing_tree
  export PYTHONDONTWRITEBYTECODE=1
  run_check "the test suite" run_suite < /dev/null
  run_check "the linter" run_linter
  run_check "the audit linter" run_audit_linter
  refuse_unless_every_check_passed
}

main "$@"
